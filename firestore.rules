rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return signedIn() &&
             request.auth.token.email is string &&
             request.auth.token.email_verified == true;
    }

    function isAllowedEditor() {
      return hasVerifiedEmail() &&
             request.auth.token.email in [
               'taladani@gmail.com',
               'eliavschreiber@gmail.com',
               'dschreiber@gmail.com',
               'gidonschreiber@gmail.com',
               'egorlin@gmail.com'
             ];
    }

    function profileComplete() {
      return signedIn() &&
             getAfter(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.onboardingComplete == true;
    }

    function isKitchenMember(kitchenId) {
      return signedIn() &&
             request.auth.uid in
               get(/databases/$(database)/documents/kitchens/$(kitchenId)).data.memberIds;
    }

    function kitchenRole(kitchenId) {
      return get(/databases/$(database)/documents/kitchens/$(kitchenId))
        .data.memberRoles[request.auth.uid];
    }

    function isKitchenAdmin(kitchenId) {
      return isKitchenMember(kitchenId) &&
             kitchenRole(kitchenId) in ['owner', 'admin'];
    }

    function isCurrentPolicyTarget(policy) {
      return policy.get('targetUid', '') == request.auth.uid ||
             (
               hasVerifiedEmail() &&
               policy.get('targetEmail', '') == request.auth.token.email
             );
    }

    function policyCoversRecipe(policy, recipe, recipeId) {
      return policy.get('active', false) == true &&
             policy.get('ownerUid', '') == recipe.get('ownerUid', '') &&
             policy.get('permissions', {}).get('view', false) == true &&
             (
               policy.get('scopeType', '') == 'recipe' ||
               policy.get('includeFuture', false) == true ||
               (
                 policy.get('recipeIds', []) is list &&
                 recipeId in policy.get('recipeIds', [])
               )
             ) &&
             (
               (
                 policy.get('scopeType', '') == 'recipe' &&
                 policy.get('scopeValue', '') == recipeId
               ) ||
               (
                 policy.get('scopeType', '') == 'category' &&
                 (
                   policy.get('scopeValue', '') == recipe.get('category', '') ||
                   policy.get('scopeValue', '') == recipe.get('mainCategory', '')
                 )
               ) ||
               (
                 policy.get('scopeType', '') == 'tag' &&
                 recipe.get('tags', []) is list &&
                 policy.get('scopeValue', '') in recipe.get('tags', [])
               ) ||
               policy.get('scopeType', '') == 'all'
             );
    }

    function hasActiveKitchenAccess(grant, recipe, recipeId) {
      let kitchen = get(
        /databases/$(database)/documents/kitchens/$(grant.kitchenId)
      ).data;
      return grant.get('grantKind', '') == 'kitchen' &&
             grant.get('kitchenId', '') in recipe.get('sharedKitchenIds', []) &&
             request.auth.uid in kitchen.get('memberIds', []) &&
             recipeId in kitchen.get('recipeIds', []);
    }

    function hasActivePolicyAccess(grant, recipe, recipeId) {
      let policy = get(
        /databases/$(database)/documents/sharePolicies/$(grant.primaryPolicyId)
      ).data;
      return grant.get('primaryPolicyId', '') != '' &&
             isCurrentPolicyTarget(policy) &&
             policyCoversRecipe(policy, recipe, recipeId);
    }

    function hasRecipeAccess(recipe, recipeId) {
      let grant = get(
        /databases/$(database)/documents/users/$(request.auth.uid)/recipeAccess/$(recipeId)
      ).data;
      return signedIn() &&
             exists(
               /databases/$(database)/documents/users/$(request.auth.uid)/recipeAccess/$(recipeId)
             ) &&
             grant.get('active', false) == true &&
             (
               (
                 grant.get('grantKind', '') == 'kitchen' &&
                 hasActiveKitchenAccess(grant, recipe, recipeId)
               ) ||
               (
                 grant.get('primaryPolicyId', '') != '' &&
                 hasActivePolicyAccess(grant, recipe, recipeId)
               )
             );
    }

    function ownsRecipeData(data) {
      return signedIn() && data.ownerUid == request.auth.uid;
    }

    function canEditRecipeData(data) {
      return ownsRecipeData(data) ||
             (
               signedIn() &&
               data.editorUids is list &&
               request.auth.uid in data.editorUids
             );
    }

    function canReadRecipeData(data, recipeId) {
      return data.visibility == 'public' ||
             ownsRecipeData(data) ||
             hasRecipeAccess(data, recipeId) ||
             (
               !('ownerUid' in data) &&
               isAllowedEditor()
             );
    }

    function hasProtectedHumanText(data) {
      let content = data.get('content', {});
      let meta = content.get('textMeta', {});
      return meta.get('source', '') in ['human', 'human-approved'];
    }

    function humanTextPrecedenceIsPreserved() {
      let previousContent = resource.data.get('content', {});
      let nextContent = request.resource.data.get('content', {});
      return !hasProtectedHumanText(resource.data) ||
             nextContent.get('text', '') == previousContent.get('text', '') ||
             hasProtectedHumanText(request.resource.data);
    }

    function recipeAccessControlIsUnchanged() {
      return request.resource.data.get('visibility', 'private') ==
               resource.data.get('visibility', 'private') &&
             request.resource.data.get('sharedKitchenIds', []) ==
               resource.data.get('sharedKitchenIds', []) &&
             request.resource.data.get('editorUids', []) ==
               resource.data.get('editorUids', []) &&
             request.resource.data.get('sharePermissions', {}) ==
               resource.data.get('sharePermissions', {});
    }

    match /recipes/{recipeId} {
      // Ownerless legacy documents are never public. Verified migration editors
      // retain read access only so an administrator can finish a repair.
      allow read: if canReadRecipeData(resource.data, recipeId);

      allow create: if profileComplete() &&
                       request.resource.data.ownerUid == request.auth.uid &&
                       request.resource.data.homeKitchenId ==
                         getAfter(
                           /databases/$(database)/documents/users/$(request.auth.uid)
                         ).data.personalKitchenId &&
                       request.resource.data.visibility in ['private', 'public'] &&
                       request.resource.data.get('sharedKitchenIds', []) == [] &&
                       request.resource.data.get('editorUids', []) == [] &&
                       request.resource.data.tags is list;

      allow update: if ('ownerUid' in resource.data) &&
                       canEditRecipeData(resource.data) &&
                       request.resource.data.ownerUid == resource.data.ownerUid &&
                       request.resource.data.homeKitchenId == resource.data.homeKitchenId &&
                       request.resource.data.tags is list &&
                       humanTextPrecedenceIsPreserved() &&
                       (
                         ownsRecipeData(resource.data) ||
                         recipeAccessControlIsUnchanged()
                       );

      allow delete: if ('ownerUid' in resource.data) &&
                       ownsRecipeData(resource.data);

      match /revisions/{revisionId} {
        function parentRecipe() {
          return get(
            /databases/$(database)/documents/recipes/$(recipeId)
          ).data;
        }

        allow read: if canReadRecipeData(parentRecipe(), recipeId);
        allow create: if canEditRecipeData(parentRecipe()) &&
                         request.resource.data.editorUid == request.auth.uid &&
                         request.resource.data.kind in ['recipe-text', 'translation-en'];
        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      allow get, create, update: if signedIn() && request.auth.uid == userId;
      allow list, delete: if false;

      match /favorites/{recipeId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }

      match /recipeAccess/{recipeId} {
        function recipeOwnerIsGranting() {
          return signedIn() &&
                 get(/databases/$(database)/documents/recipes/$(recipeId))
                   .data.ownerUid == request.auth.uid;
        }

        function targetIsClaimingPolicy() {
          let policyId = request.resource.data.primaryPolicyId;
          let policy = get(
            /databases/$(database)/documents/sharePolicies/$(policyId)
          ).data;
          let recipe = get(
            /databases/$(database)/documents/recipes/$(recipeId)
          ).data;
          return signedIn() &&
                 request.auth.uid == userId &&
                 request.resource.data.recipeId == recipeId &&
                 request.resource.data.active == true &&
                 isCurrentPolicyTarget(policy) &&
                 policyCoversRecipe(policy, recipe, recipeId);
        }

        function targetIsClaimingKitchenAccess() {
          let invitationId = request.resource.data.invitationId;
          let invitation = get(
            /databases/$(database)/documents/invitations/$(invitationId)
          ).data;
          let kitchenId = request.resource.data.kitchenId;
          let kitchen = get(
            /databases/$(database)/documents/kitchens/$(kitchenId)
          ).data;
          let recipe = get(
            /databases/$(database)/documents/recipes/$(recipeId)
          ).data;
          return signedIn() &&
                 request.auth.uid == userId &&
                 request.resource.data.recipeId == recipeId &&
                 request.resource.data.grantKind == 'kitchen' &&
                 request.resource.data.active == true &&
                 invitation.type == 'kitchen' &&
                 invitation.status == 'accepted' &&
                 invitation.acceptedByUid == request.auth.uid &&
                 invitation.kitchenId == kitchenId &&
                 request.auth.uid in kitchen.memberIds &&
                 recipeId in kitchen.recipeIds &&
                 kitchenId in recipe.sharedKitchenIds;
        }

        function kitchenAdminIsGrantingApprovedRequest() {
          let kitchenId = request.resource.data.get('kitchenId', '');
          let accessRequestId =
            request.resource.data.get('sourceAccessRequestId', '');
          let kitchen = getAfter(
            /databases/$(database)/documents/kitchens/$(kitchenId)
          ).data;
          let accessRequest = getAfter(
            /databases/$(database)/documents/kitchenAccessRequests/$(accessRequestId)
          ).data;
          return request.resource.data.get('grantKind', '') == 'kitchen' &&
                 kitchenId != '' &&
                 accessRequestId != '' &&
                 signedIn() &&
                 isKitchenAdmin(kitchenId) &&
                 request.resource.data.recipeId == recipeId &&
                 request.resource.data.grantKind == 'kitchen' &&
                 request.resource.data.active == true &&
                 request.resource.data.grantedByUid == request.auth.uid &&
                 accessRequest.status == 'approved' &&
                 accessRequest.resolverUid == request.auth.uid &&
                 accessRequest.requesterUid == userId &&
                 accessRequest.resolvedKitchenId == kitchenId &&
                 request.auth.uid in accessRequest.recipientUids &&
                 userId in kitchen.memberIds &&
                 recipeId in kitchen.recipeIds;
        }

        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if kitchenAdminIsGrantingApprovedRequest() ||
                                 recipeOwnerIsGranting() ||
                                 targetIsClaimingPolicy() ||
                                 targetIsClaimingKitchenAccess();
        allow delete: if recipeOwnerIsGranting() ||
                         (signedIn() && request.auth.uid == userId);
      }

      match /recipeOverrides/{recipeId} {
        allow read, create, update, delete: if signedIn() &&
                                             request.auth.uid == userId;
      }
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() &&
                       resource.data.uid == request.auth.uid &&
                       request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /emailDirectory/{emailHash} {
      // Retired: Firestore Rules cannot prove that a client-supplied SHA-256
      // document ID belongs to request.auth.token.email. Email invitations use
      // the verified Firebase Auth email claim directly instead.
      allow read, write: if false;
    }

    match /kitchenDirectory/{lookupKey} {
      function validDirectoryCreate() {
        let kitchen = getAfter(
          /databases/$(database)/documents/kitchens/$(request.resource.data.kitchenId)
        ).data;
        return profileComplete() &&
               kitchen.type == 'shared' &&
               kitchen.ownerUid == request.auth.uid &&
               request.resource.data.ownerUid == request.auth.uid &&
               request.resource.data.kitchenName == kitchen.name &&
               request.resource.data.normalizedName == kitchen.nameNormalized &&
               request.resource.data.adminUids == [request.auth.uid];
      }

      allow get: if signedIn();
      allow list: if false;
      allow create: if validDirectoryCreate();
      allow update: if isKitchenAdmin(resource.data.kitchenId) &&
                       request.resource.data.adminUids is list &&
                       (
                         (
                           request.auth.uid in resource.data.adminUids &&
                           request.resource.data.adminUids ==
                             resource.data.adminUids
                         ) ||
                         (
                           !(request.auth.uid in resource.data.adminUids) &&
                           request.auth.uid in request.resource.data.adminUids &&
                           request.resource.data.adminUids.hasAll(
                             resource.data.adminUids
                           ) &&
                           request.resource.data.adminUids.size() ==
                             resource.data.adminUids.size() + 1
                         )
                       ) &&
                       request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['adminUids', 'updatedAt']);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /kitchens/{kitchenId} {
      function validNewKitchen() {
        return profileComplete() &&
               request.resource.data.ownerUid == request.auth.uid &&
               request.resource.data.memberIds == [request.auth.uid] &&
               request.resource.data.memberRoles[request.auth.uid] == 'owner' &&
               request.resource.data.memberRoles.keys()
                 .hasOnly([request.auth.uid]) &&
               request.resource.data.type in ['personal', 'shared'];
      }

      function validInvitationJoin() {
        let invitationId = request.resource.data.lastAcceptedInvitationId;
        let invitationBefore = get(
          /databases/$(database)/documents/invitations/$(invitationId)
        ).data;
        let invitationAfter = getAfter(
          /databases/$(database)/documents/invitations/$(invitationId)
        ).data;
        return signedIn() &&
               invitationBefore.status == 'pending' &&
               invitationAfter.status == 'accepted' &&
               invitationBefore.kitchenId == kitchenId &&
               (
                 invitationBefore.targetUid == request.auth.uid ||
                 (
                   hasVerifiedEmail() &&
                   invitationBefore.targetEmail == request.auth.token.email
                 )
               ) &&
               !(request.auth.uid in resource.data.memberIds) &&
               request.auth.uid in request.resource.data.memberIds &&
               request.resource.data.memberIds.size() ==
                 resource.data.memberIds.size() + 1 &&
               request.resource.data.memberRoles[request.auth.uid] ==
                 invitationBefore.role &&
               request.resource.data.memberRoles.diff(resource.data.memberRoles)
                 .affectedKeys().hasOnly([request.auth.uid]) &&
               request.resource.data.ownerUid == resource.data.ownerUid &&
               resource.data.ownerUid in request.resource.data.memberIds &&
               request.resource.data.memberRoles[resource.data.ownerUid] == 'owner' &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'memberIds',
                 'memberRoles',
                 'lastAcceptedInvitationId',
                 'updatedAt'
               ]);
      }

      function validApprovedAccessRequestJoin() {
        let accessRequestId =
          request.resource.data.get('lastApprovedAccessRequestId', '');
        let accessRequestBefore = get(
          /databases/$(database)/documents/kitchenAccessRequests/$(accessRequestId)
        ).data;
        let accessRequestAfter = getAfter(
          /databases/$(database)/documents/kitchenAccessRequests/$(accessRequestId)
        ).data;
        let requesterUid = accessRequestBefore.requesterUid;
        return accessRequestId != '' &&
               isKitchenAdmin(kitchenId) &&
               accessRequestBefore.status == 'pending' &&
               accessRequestAfter.status == 'approved' &&
               accessRequestAfter.resolverUid == request.auth.uid &&
               accessRequestAfter.resolvedKitchenId == kitchenId &&
               request.auth.uid in accessRequestBefore.recipientUids &&
               (
                 accessRequestBefore.get('targetKitchenId', '') == '' ||
                 accessRequestBefore.targetKitchenId == kitchenId
               ) &&
               !(requesterUid in resource.data.memberIds) &&
               requesterUid in request.resource.data.memberIds &&
               request.resource.data.memberIds.size() ==
                 resource.data.memberIds.size() + 1 &&
               request.resource.data.memberRoles[requesterUid] == 'member' &&
               request.resource.data.memberRoles.diff(resource.data.memberRoles)
                 .affectedKeys().hasOnly([requesterUid]) &&
               request.resource.data.ownerUid == resource.data.ownerUid &&
               resource.data.ownerUid in request.resource.data.memberIds &&
               request.resource.data.memberRoles[resource.data.ownerUid] == 'owner' &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'memberIds',
                 'memberRoles',
                 'lastApprovedAccessRequestId',
                 'updatedAt'
               ]);
      }

      function validRecipeIndexUpdate() {
        return isKitchenAdmin(kitchenId) &&
               request.resource.data.ownerUid == resource.data.ownerUid &&
               resource.data.ownerUid in request.resource.data.memberIds &&
               request.resource.data.memberRoles[resource.data.ownerUid] == 'owner' &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'recipeIds',
                 'updatedAt'
               ]);
      }

      function validMemberRemoval() {
        let removedUids =
          resource.data.memberIds.removeAll(request.resource.data.memberIds);
        let removedUid = removedUids[0];
        return signedIn() &&
               request.auth.uid == resource.data.ownerUid &&
               removedUids.size() == 1 &&
               removedUid != resource.data.ownerUid &&
               resource.data.memberIds.hasAll(request.resource.data.memberIds) &&
               request.resource.data.memberIds.size() ==
                 resource.data.memberIds.size() - 1 &&
               !(removedUid in request.resource.data.memberRoles) &&
               request.resource.data.memberRoles.diff(resource.data.memberRoles)
                 .affectedKeys().hasOnly([removedUid]) &&
               request.resource.data.ownerUid == resource.data.ownerUid &&
               resource.data.ownerUid in request.resource.data.memberIds &&
               request.resource.data.memberRoles[resource.data.ownerUid] == 'owner' &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'memberIds',
                 'memberRoles',
                 'updatedAt'
               ]);
      }

      function validPersonalKitchenRepair() {
        return signedIn() &&
               resource.data.ownerUid == request.auth.uid &&
               resource.data.type == 'personal' &&
               request.resource.data.ownerUid == request.auth.uid &&
               request.resource.data.type == 'personal' &&
               request.resource.data.memberIds == [request.auth.uid] &&
               request.resource.data.memberRoles[request.auth.uid] == 'owner' &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'name',
                 'type',
                 'ownerUid',
                 'memberIds',
                 'memberRoles',
                 'createdAt',
                 'updatedAt'
               ]);
      }

      allow get, list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if validNewKitchen();
      allow update: if validRecipeIndexUpdate() ||
                       validPersonalKitchenRepair() ||
                       validInvitationJoin() ||
                       validApprovedAccessRequestJoin() ||
                       validMemberRemoval();
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /invitations/{invitationId} {
      function isInvitationTarget(data) {
        return signedIn() &&
               (
                 data.targetUid == request.auth.uid ||
                 (
                   hasVerifiedEmail() &&
                   data.targetEmail == request.auth.token.email &&
                   data.targetEmail != null
                 )
               );
      }

      function hasValidInvitationTarget(data) {
        return (
                 data.targetUid is string &&
                 data.targetUid != request.auth.uid &&
                 data.targetEmail == null
               ) ||
               (
                 data.targetUid == null &&
                 data.targetEmail is string &&
                 data.targetEmail != request.auth.token.email
               );
      }

      function validRecipeShareInvitation() {
        let policy = get(
          /databases/$(database)/documents/sharePolicies/$(
            request.resource.data.get('sharePolicyId', '')
          )
        ).data;
        return request.resource.data.type == 'recipe-share' &&
               policy.ownerUid == request.auth.uid &&
               request.resource.data.targetUid == policy.targetUid &&
               request.resource.data.targetEmail == policy.targetEmail;
      }

      function inviterMayCreate() {
        return signedIn() &&
               request.resource.data.inviterUid == request.auth.uid &&
               request.resource.data.status == 'pending' &&
               hasValidInvitationTarget(request.resource.data) &&
               (
                 (
                   request.resource.data.type == 'kitchen' &&
                   isKitchenAdmin(request.resource.data.kitchenId) &&
                   request.resource.data.role in ['member', 'admin']
                 ) ||
                 validRecipeShareInvitation()
               );
      }

      allow get, list: if signedIn() &&
                         (
                           resource.data.inviterUid == request.auth.uid ||
                           isInvitationTarget(resource.data)
                         );
      allow create: if inviterMayCreate();
      allow update: if (
                      isInvitationTarget(resource.data) &&
                      resource.data.status == 'pending' &&
                      (
                        (
                          request.resource.data.status == 'accepted' &&
                          request.resource.data.acceptedByUid == request.auth.uid &&
                          request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly([
                              'status',
                              'acceptedByUid',
                              'acceptedAt'
                            ])
                        ) ||
                        (
                          request.resource.data.status == 'declined' &&
                          request.resource.data.declinedByUid == request.auth.uid &&
                          request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly([
                              'status',
                              'declinedByUid',
                              'declinedAt'
                            ])
                        )
                      )
                    ) ||
                    (
                      resource.data.inviterUid == request.auth.uid &&
                      request.resource.data.status == 'cancelled' &&
                      request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['status', 'cancelledAt'])
                    );
      allow delete: if false;
    }

    match /kitchenAccessRequests/{accessRequestId} {
      function validKitchenRequestTarget() {
        let directory = get(
          /databases/$(database)/documents/kitchenDirectory/$(request.resource.data.directoryKey)
        ).data;
        return request.resource.data.targetKind == 'kitchen' &&
               request.resource.data.targetKitchenId == directory.kitchenId &&
               request.resource.data.targetKitchenName == directory.kitchenName &&
               request.resource.data.recipientUids == directory.adminUids;
      }

      function validUserRequestTarget() {
        return request.resource.data.targetKind == 'user' &&
               request.resource.data.targetUid != request.auth.uid &&
               request.resource.data.recipientUids ==
                 [request.resource.data.targetUid];
      }

      function validNewAccessRequest() {
        return profileComplete() &&
               request.resource.data.requesterUid == request.auth.uid &&
               request.resource.data.status == 'pending' &&
               request.resource.data.recipientUids is list &&
               request.resource.data.recipientUids.size() > 0 &&
               request.resource.data.recipientUids.size() <= 20 &&
               !(request.auth.uid in request.resource.data.recipientUids) &&
               (
                 validKitchenRequestTarget() ||
                 validUserRequestTarget()
               );
      }

      function approvedRequestIsMaterialized() {
        let resolvedKitchenId =
          request.resource.data.get('resolvedKitchenId', '');
        let resolvedKitchen = getAfter(
          /databases/$(database)/documents/kitchens/$(resolvedKitchenId)
        ).data;
        return resolvedKitchenId != '' &&
               isKitchenAdmin(resolvedKitchenId) &&
               resource.data.requesterUid in resolvedKitchen.memberIds &&
               (
                 resource.data.get('targetKitchenId', '') == '' ||
                 resource.data.targetKitchenId == resolvedKitchenId
               );
      }

      function recipientMayResolve() {
        return signedIn() &&
               request.auth.uid in resource.data.recipientUids &&
               resource.data.status == 'pending' &&
               request.resource.data.status in ['approved', 'declined'] &&
               request.resource.data.resolverUid == request.auth.uid &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'status',
                 'resolverUid',
                 'resolvedAt',
                 'resolvedKitchenId',
                 'invitationId',
                 'updatedAt'
               ]) &&
               (
                 request.resource.data.status == 'declined' ||
                 approvedRequestIsMaterialized()
               );
      }

      function requesterMayRetry() {
        return signedIn() &&
               resource.data.requesterUid == request.auth.uid &&
               resource.data.status == 'declined' &&
               request.resource.data.status == 'pending' &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'status',
                 'requesterName',
                 'requesterUsername',
                 'requesterEmail',
                 'createdAt',
                 'updatedAt',
                 'resolverUid',
                 'resolvedAt',
                 'resolvedKitchenId',
                 'invitationId'
               ]);
      }

      allow get, list: if signedIn() &&
                         (
                           resource.data.requesterUid == request.auth.uid ||
                           request.auth.uid in resource.data.recipientUids
                         );
      allow create: if validNewAccessRequest();
      allow update: if recipientMayResolve() || requesterMayRetry();
      allow delete: if false;
    }

    match /sharePolicies/{policyId} {
      function hasValidPolicyTarget() {
        return (
                 request.resource.data.targetType == 'user' &&
                 (
                   (
                     request.resource.data.targetUid is string &&
                     request.resource.data.targetUid.size() > 0 &&
                     request.resource.data.targetEmail == null
                   ) ||
                   (
                     request.resource.data.targetEmail is string &&
                     request.resource.data.targetEmail.size() > 3 &&
                     request.resource.data.targetUid == null
                   )
                 )
               ) ||
               (
                 request.resource.data.targetType == 'kitchen' &&
                 request.resource.data.targetId is string &&
                 request.resource.data.targetId.size() > 0 &&
                 request.resource.data.targetUid == null &&
                 request.resource.data.targetEmail == null
               );
      }

      allow get, list: if signedIn() &&
                         (
                           resource.data.ownerUid == request.auth.uid ||
                           resource.data.targetUid == request.auth.uid ||
                           (
                             hasVerifiedEmail() &&
                             resource.data.targetEmail == request.auth.token.email &&
                             resource.data.targetEmail != null
                           ) ||
                           (
                             resource.data.targetType == 'kitchen' &&
                             isKitchenMember(resource.data.targetId)
                           )
                         );
      allow create: if profileComplete() &&
                       request.resource.data.ownerUid == request.auth.uid &&
                       hasValidPolicyTarget() &&
                       request.resource.data.scopeType in ['recipe', 'category', 'tag', 'all'] &&
                       request.resource.data.get('recipeIds', []) is list &&
                       request.resource.data.get('recipeIds', []).size() <= 500 &&
                       request.resource.data.active == true &&
                       request.resource.data.get('permissions', {}).get('view', false) == true;
      allow update: if signedIn() &&
                       resource.data.ownerUid == request.auth.uid &&
                       request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /cookingWorkspaces/{userId} {
      function isWorkspaceOwner() {
        return signedIn() && request.auth.uid == userId;
      }

      function isValidWorkspace() {
        return request.resource.data.keys().hasOnly([
                 'recipeIds',
                 'activeRecipeId',
                 'view',
                 'checkedIngredientIds',
                 'checkedStepIds',
                 'planCacheKey',
                 'updatedAt'
               ]) &&
               request.resource.data.recipeIds is list &&
               request.resource.data.recipeIds.size() <= 12 &&
               (
                 !('view' in request.resource.data) ||
                 request.resource.data.view in ['recipes', 'ingredients', 'timeline']
               ) &&
               (
                 !('checkedIngredientIds' in request.resource.data) ||
                 (
                   request.resource.data.checkedIngredientIds is list &&
                   request.resource.data.checkedIngredientIds.size() <= 500
                 )
               ) &&
               (
                 !('checkedStepIds' in request.resource.data) ||
                 (
                   request.resource.data.checkedStepIds is list &&
                   request.resource.data.checkedStepIds.size() <= 500
                 )
               ) &&
               (
                 request.resource.data.activeRecipeId == null ||
                 request.resource.data.activeRecipeId in request.resource.data.recipeIds
               );
      }

      allow read, delete: if isWorkspaceOwner();
      allow create, update: if isWorkspaceOwner() && isValidWorkspace();
    }

    match /settings/{documentId} {
      allow read: if true;
      allow write: if isAllowedEditor();
    }
  }
}
